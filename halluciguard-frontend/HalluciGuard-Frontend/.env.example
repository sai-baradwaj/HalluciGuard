# Base URL of the HalluciGuard FastAPI backend (no trailing slash needed)
VITE_API_BASE_URL=http://127.0.0.1:8000
# Development key sent as the x-api-key header. Never put production secrets in a browser app.
VITE_API_KEY=halluciguard-dev-key
# Set to "true" to start in demo mode (mock data, clearly labelled). Users can also toggle it in the header.
VITE_USE_MOCK=false
